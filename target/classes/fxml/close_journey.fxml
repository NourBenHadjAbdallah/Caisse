<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.caisse.controller.CloseJourneyController"
            styleClass="root-pane" prefWidth="560" prefHeight="520">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="topbar">
            <padding><Insets top="12" right="20" bottom="12" left="20"/></padding>
            <Label text="RÉSUMÉ DE JOURNÉE" styleClass="app-title"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="10" styleClass="card">
            <padding><Insets top="24" right="30" bottom="24" left="30"/></padding>

            <Label fx:id="journeyLabel" styleClass="section-title"/>
            <Label fx:id="cashierLabel"/>
            <Separator/>

            <GridPane hgap="16" vgap="8">
                <Label text="Tickets:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Label fx:id="ticketsLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Ventes brutes:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Label fx:id="grossLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Espèces:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <Label fx:id="cashLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Carte bancaire:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <Label fx:id="cardLabel" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Retours:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <Label fx:id="returnsLabel" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            </GridPane>

            <Separator/>
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Label text="Ventes nettes:" styleClass="section-title"/>
                <Label fx:id="netLabel" styleClass="section-title"/>
            </HBox>

            <Region VBox.vgrow="ALWAYS"/>

            <HBox alignment="CENTER" spacing="16">
                <Button text="Annuler" styleClass="btn-secondary" prefWidth="160" onAction="#onCancel"/>
                <Button text="Fermer la journée" styleClass="btn-danger" prefWidth="200" onAction="#onConfirmClose"/>
            </HBox>

            <ProgressIndicator fx:id="progressIndicator" visible="false" maxHeight="24" maxWidth="24"/>
        </VBox>
    </center>
</BorderPane>
