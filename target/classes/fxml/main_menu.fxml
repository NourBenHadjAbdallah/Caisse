<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.caisse.controller.MainMenuController"
            prefWidth="1200"
            prefHeight="700"
            styleClass="root-pane">

    <center>

        <HBox styleClass="main-layout">

            <!-- ================================================= -->
            <!-- LEFT MENU -->
            <!-- ================================================= -->

            <VBox prefWidth="350"
                  minWidth="320"
                  maxWidth="400"
                  spacing="20"
                  styleClass="side-menu">

                <padding>
                    <Insets top="35"
                            right="30"
                            bottom="30"
                            left="30"/>
                </padding>

                <!-- MENU TITLE -->

                <VBox spacing="5">

                    <Label text="MENU"
                           styleClass="menu-title"/>

                    <Label fx:id="cashierLabel"
                           styleClass="cashier-label"/>

                    <Label fx:id="journeyBadge"
                           styleClass="badge"/>

                </VBox>


                <!-- MENU BUTTONS -->

                <VBox spacing="15"
                      VBox.vgrow="NEVER">

                    <Button text="Journée"
                            maxWidth="Infinity"
                            prefHeight="75"
                            styleClass="btn-menu"
                            onAction="#onJourney"/>

                    <Button fx:id="ticketsButton"
                            text="Tickets"
                            maxWidth="Infinity"
                            prefHeight="75"
                            styleClass="btn-menu"
                            onAction="#onTickets"/>

                    <Button fx:id="returnsButton"
                            text="Retours"
                            maxWidth="Infinity"
                            prefHeight="75"
                            styleClass="btn-menu"
                            onAction="#onReturns"/>

                    <Button text="Stock"
                            maxWidth="Infinity"
                            prefHeight="75"
                            styleClass="btn-menu"
                            onAction="#onStock"/>

                    <Button text="Rapports"
                            maxWidth="Infinity"
                            prefHeight="75"
                            styleClass="btn-menu"
                            onAction="#onReports"/>

                </VBox>


                <!-- PUSH LOGOUT TO BOTTOM -->

                <Region VBox.vgrow="ALWAYS"/>


                <!-- LOGOUT -->

                <Button text="Déconnexion"
                        maxWidth="Infinity"
                        prefHeight="65"
                        styleClass="btn-secondary"
                        onAction="#onLogout"/>

            </VBox>


            <!-- ================================================= -->
            <!-- RIGHT WORKSPACE -->
            <!-- ================================================= -->

            <StackPane HBox.hgrow="ALWAYS"
                       styleClass="workspace">

                <VBox alignment="CENTER"
                      spacing="15">

                    <Label text="Bienvenue"
                           styleClass="workspace-title"/>

                    <Label text="Sélectionnez une option dans le menu"
                           styleClass="workspace-subtitle"/>

                </VBox>

            </StackPane>

        </HBox>

    </center>

</BorderPane>