<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.caisse.controller.MainMenuController"
            prefWidth="1200"
            prefHeight="700"
            styleClass="root-pane">


    <center>

        <HBox styleClass="main-layout">


            <!-- ================================================= -->
            <!-- LEFT MENU -->
            <!-- ================================================= -->

            <VBox prefWidth="300"
                  minWidth="280"
                  maxWidth="340"
                  spacing="24"
                  styleClass="side-menu">

                <padding>
                    <Insets top="35"
                            right="24"
                            bottom="30"
                            left="24"/>
                </padding>


                <!-- ================================================= -->
                <!-- HEADER -->
                <!-- ================================================= -->

                <VBox spacing="6">

                    <Label text="MENU"
                           styleClass="menu-title"/>

                    <Label fx:id="cashierLabel"
                           styleClass="cashier-label"/>

                    <Label fx:id="journeyBadge"
                           styleClass="badge"/>

                </VBox>


                <!-- ================================================= -->
                <!-- MAIN NAV LIST (Tickets first) -->
                <!-- ================================================= -->

                <VBox spacing="4">

                    <Button fx:id="ticketsButton"
                            text="Tickets"
                            maxWidth="Infinity"
                            styleClass="nav-link"
                            onAction="#onTickets"/>

                    <Button fx:id="returnsButton"
                            text="Retours"
                            maxWidth="Infinity"
                            styleClass="nav-link"
                            onAction="#onReturns"/>

                    <Button text="Stock"
                            maxWidth="Infinity"
                            styleClass="nav-link"
                            onAction="#onStock"/>

                    <Button text="Rapports"
                            maxWidth="Infinity"
                            styleClass="nav-link"
                            onAction="#onReports"/>

                </VBox>


                <!-- ================================================= -->
                <!-- SPACE -->
                <!-- ================================================= -->

                <Region VBox.vgrow="ALWAYS"/>


                <!-- ================================================= -->
                <!-- JOURNEY (bottom, expandable) -->
                <!-- ================================================= -->

                <VBox spacing="4">

                    <Button fx:id="journeyToggleButton"
                            text="Journée   ▾"
                            maxWidth="Infinity"
                            styleClass="nav-toggle"
                            onAction="#onToggleJourneyMenu"/>

                    <VBox fx:id="journeySubmenu"
                          spacing="2"
                          visible="false"
                          managed="false"
                          styleClass="nav-submenu">

                        <Button fx:id="openJourneyButton"
                                text="Ouvrir la journée"
                                maxWidth="Infinity"
                                styleClass="nav-sub-link"
                                onAction="#onOpenJourneyQuick"/>

                        <Button fx:id="closeJourneyButton"
                                text="Fermer la journée"
                                maxWidth="Infinity"
                                styleClass="nav-sub-link"
                                onAction="#onCloseJourneyQuick"/>

                    </VBox>

                    <HBox alignment="CENTER_LEFT">
                        <ProgressIndicator fx:id="journeyProgress"
                                           visible="false"
                                           maxHeight="18"
                                           maxWidth="18"/>
                    </HBox>

                </VBox>


                <!-- ================================================= -->
                <!-- LOGOUT -->
                <!-- ================================================= -->

                <Button text="Déconnexion"
                        maxWidth="Infinity"
                        prefHeight="55"
                        styleClass="btn-secondary"
                        onAction="#onLogout"/>

            </VBox>


            <!-- ================================================= -->
            <!-- RIGHT WORKSPACE -->
            <!-- ================================================= -->

            <StackPane HBox.hgrow="ALWAYS"
                       styleClass="workspace">

                <VBox alignment="CENTER"
                      spacing="15">

                    <Label text="Bienvenue"
                           styleClass="workspace-title"/>


                    <Label text="Sélectionnez une option dans le menu"
                           styleClass="workspace-subtitle"/>

                </VBox>

            </StackPane>

        </HBox>

    </center>

</BorderPane>