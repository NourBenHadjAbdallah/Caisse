<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.caisse.controller.TicketZController"
            prefWidth="1200"
            prefHeight="700"
            styleClass="root-pane">

    <center>

        <HBox styleClass="main-layout">

            <!-- ================================================= -->
            <!-- LEFT SIDEBAR -->
            <!-- ================================================= -->

            <VBox prefWidth="320"
                  minWidth="300"
                  maxWidth="360"
                  spacing="20"
                  styleClass="side-menu">

                <padding>
                    <Insets top="35"
                            right="30"
                            bottom="30"
                            left="30"/>
                </padding>


                <!-- HEADER -->

                <VBox spacing="8">

                    <Label text="TICKET Z"
                           styleClass="menu-title"/>

                    <Label text="Journée fermée définitivement"
                           styleClass="subtitle"/>

                </VBox>


                <!-- INFO -->

                <VBox spacing="15">

                    <Label text="ARCHIVAGE"
                           styleClass="section-title"/>

                    <Label text="Conservez ce document : il récapitule les ventes et la liste des règlements comptés pour cette journée, qui est maintenant fermée."
                           wrapText="true"
                           styleClass="subtitle"/>

                </VBox>


                <Region VBox.vgrow="ALWAYS"/>


                <!-- ACTIONS -->

                <Button text="Enregistrer en PDF"
                        maxWidth="Infinity"
                        prefHeight="60"
                        styleClass="btn-secondary"
                        onAction="#onSavePdf"/>

                <Button text="Imprimer"
                        maxWidth="Infinity"
                        prefHeight="65"
                        styleClass="btn-primary"
                        onAction="#onPrint"/>

                <Button text="Terminer"
                        maxWidth="Infinity"
                        prefHeight="55"
                        styleClass="btn-back"
                        onAction="#onFinish"/>

            </VBox>


            <!-- ================================================= -->
            <!-- RIGHT WORKSPACE -->
            <!-- ================================================= -->

            <StackPane HBox.hgrow="ALWAYS"
                       styleClass="workspace">

                <ScrollPane fitToWidth="true"
                            fitToHeight="true"
                            styleClass="receipt-scroll">

                    <StackPane styleClass="receipt-paper-wrapper">

                        <VBox fx:id="receiptContainer"
                              styleClass="receipt-paper"/>

                    </StackPane>

                </ScrollPane>

            </StackPane>

        </HBox>

    </center>

</BorderPane>