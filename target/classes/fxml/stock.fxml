<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.caisse.controller.StockController"
            prefWidth="1200"
            prefHeight="700"
            styleClass="root-pane">

    <center>

        <HBox styleClass="main-layout">

            <!-- ================================================= -->
            <!-- LEFT SIDEBAR -->
            <!-- ================================================= -->

            <VBox prefWidth="320"
                  minWidth="300"
                  maxWidth="360"
                  spacing="20"
                  styleClass="side-menu">

                <padding>
                    <Insets top="35"
                            right="30"
                            bottom="30"
                            left="30"/>
                </padding>


                <!-- HEADER -->

                <VBox spacing="8">

                    <Button text="‹  Retour"
                            prefHeight="65"
                            maxWidth="Infinity"
                            styleClass="btn-back"
                            onAction="#onBack"/>

                    <Label text="STOCK"
                           styleClass="menu-title"/>

                    <Label text="Consultation du stock"
                           styleClass="subtitle"/>

                </VBox>


                <!-- INFO -->

                <VBox spacing="15">

                    <Label text="RECHERCHE ET FILTRES"
                           styleClass="section-title"/>

                    <Label text="Recherchez un produit par code ou libellé, puis affinez avec les filtres de stock, prix ou remise."
                           wrapText="true"
                           styleClass="subtitle"/>

                </VBox>


                <Region VBox.vgrow="ALWAYS"/>

            </VBox>


            <!-- ================================================= -->
            <!-- RIGHT WORKSPACE -->
            <!-- ================================================= -->

            <StackPane HBox.hgrow="ALWAYS"
                       styleClass="workspace">

                <VBox spacing="18">

                    <padding>
                        <Insets top="35"
                                right="40"
                                bottom="35"
                                left="40"/>
                    </padding>


                    <!-- PAGE TITLE -->

                    <VBox spacing="5">

                        <Label text="Catalogue produits"
                               styleClass="workspace-title"/>

                        <Label text="Consultez le stock, les prix normaux et les remises en cours."
                               styleClass="workspace-subtitle"/>

                    </VBox>


                    <!-- ================================================= -->
                    <!-- SEARCH -->
                    <!-- ================================================= -->

                    <HBox spacing="15"
                          alignment="CENTER_LEFT">

                        <TextField fx:id="searchField"
                                   promptText="Rechercher un produit (code ou libellé)"
                                   prefHeight="60"
                                   HBox.hgrow="ALWAYS"
                                   onAction="#onSearch"/>

                        <Button text="Rechercher"
                                prefWidth="160"
                                prefHeight="60"
                                styleClass="btn-primary"
                                onAction="#onSearch"/>

                        <Button text="Tout afficher"
                                prefWidth="160"
                                prefHeight="60"
                                styleClass="btn-secondary"
                                onAction="#onListAll"/>

                    </HBox>


                    <!-- ================================================= -->
                    <!-- FILTERS -->
                    <!-- ================================================= -->

                    <HBox spacing="15"
                          alignment="CENTER_LEFT">

                        <ComboBox fx:id="stockStatusCombo"
                                  promptText="Statut stock"
                                  prefHeight="55"
                                  prefWidth="180"/>

                        <ComboBox fx:id="discountCombo"
                                  promptText="Remise"
                                  prefHeight="55"
                                  prefWidth="160"/>

                        <TextField fx:id="minPriceField"
                                   promptText="Prix min"
                                   prefHeight="55"
                                   prefWidth="120"/>

                        <TextField fx:id="maxPriceField"
                                   promptText="Prix max"
                                   prefHeight="55"
                                   prefWidth="120"/>

                        <Button text="Filtrer"
                                prefWidth="140"
                                prefHeight="55"
                                styleClass="btn-primary"
                                onAction="#onApplyFilters"/>

                        <Button text="Réinitialiser"
                                prefWidth="150"
                                prefHeight="55"
                                styleClass="btn-secondary"
                                onAction="#onResetFilters"/>

                    </HBox>


                    <Label fx:id="resultCountLabel"
                           styleClass="subtitle"/>


                    <!-- ================================================= -->
                    <!-- STOCK TABLE -->
                    <!-- ================================================= -->

                    <TableView fx:id="stockTable"
                               VBox.vgrow="ALWAYS"
                               prefHeight="420">

                        <columns>

                            <TableColumn fx:id="colCode"
                                         text="Code"
                                         prefWidth="100"/>

                            <TableColumn fx:id="colLabel"
                                         text="Libellé"
                                         prefWidth="260"/>

                            <TableColumn fx:id="colStock"
                                         text="Stock"
                                         prefWidth="100"/>

                            <TableColumn fx:id="colNormalPrice"
                                         text="Prix normal"
                                         prefWidth="130"/>

                            <TableColumn fx:id="colDiscount"
                                         text="Remise %"
                                         prefWidth="110"/>

                            <TableColumn fx:id="colFinalPrice"
                                         text="Prix final"
                                         prefWidth="130"/>

                        </columns>

                    </TableView>


                    <!-- LOADING -->

                    <HBox alignment="CENTER_RIGHT">

                        <ProgressIndicator fx:id="progressIndicator"
                                           visible="false"
                                           maxHeight="30"
                                           maxWidth="30"/>

                    </HBox>

                </VBox>

            </StackPane>

        </HBox>

    </center>

</BorderPane>