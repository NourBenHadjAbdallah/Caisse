<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.caisse.controller.LoginController"
      styleClass="root-pane" prefWidth="1200" prefHeight="700">

    <!-- ================================================= -->
    <!-- LEFT BRAND PANEL (50%) -->
    <!-- ================================================= -->

    <StackPane HBox.hgrow="ALWAYS"
               styleClass="login-hero">

        <VBox alignment="CENTER"
              spacing="18"
              maxWidth="380">


            <Label text="CAISSE"
                   styleClass="login-hero-title"/>

            <Label text="POINT DE VENTE"
                   styleClass="login-hero-subtitle"/>

            <VBox styleClass="login-hero-divider"
                  maxWidth="60"
                  prefHeight="3"/>

            <ImageView fitWidth="580"
                       preserveRatio="true"
                       smooth="true">
                <Image url="@../images/pos_illustration.jpg"/>
            </ImageView>


        </VBox>

    </StackPane>


    <!-- ================================================= -->
    <!-- RIGHT LOGIN FORM (50%) -->
    <!-- ================================================= -->

    <StackPane HBox.hgrow="ALWAYS"
               styleClass="login-form-pane">

        <VBox alignment="CENTER"
              spacing="18"
              maxWidth="380">

            <padding>
                <Insets top="45" right="45" bottom="45" left="45"/>
            </padding>

            <Label text="Connexion caissier"
                   styleClass="section-title"/>


            <VBox spacing="6"
                  maxWidth="Infinity">

                <Label text="Email"
                       styleClass="field-label"/>

                <TextField fx:id="emailField"
                           promptText="votre.email@exemple.com"
                           prefHeight="52"/>

            </VBox>

            <VBox spacing="6"
                  maxWidth="Infinity">

                <Label text="Mot de passe"
                       styleClass="field-label"/>

                <PasswordField fx:id="passwordField"
                               promptText="••••••••"
                               prefHeight="52"
                               onAction="#onLogin"/>

            </VBox>

            <Button text="Se connecter"
                    defaultButton="true"
                    maxWidth="Infinity"
                    prefHeight="58"
                    styleClass="btn-primary"
                    onAction="#onLogin"/>

            <Label fx:id="statusLabel"
                   styleClass="error-text"
                   wrapText="true"
                   maxWidth="290"
                   textAlignment="CENTER"/>

            <ProgressIndicator fx:id="progressIndicator"
                               visible="false"
                               maxHeight="26"
                               maxWidth="26"/>

        </VBox>

    </StackPane>

</HBox>