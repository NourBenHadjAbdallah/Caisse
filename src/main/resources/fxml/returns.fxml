<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.caisse.controller.ReturnController"
            prefWidth="1200"
            prefHeight="700"
            styleClass="root-pane">

    <center>

        <HBox styleClass="main-layout">

            <!-- ========================= -->
            <!-- LEFT SIDEBAR -->
            <!-- ========================= -->

            <VBox prefWidth="320"
                  minWidth="300"
                  maxWidth="360"
                  spacing="20"
                  styleClass="side-menu">

                <padding>
                    <Insets top="35"
                            right="30"
                            bottom="30"
                            left="30"/>
                </padding>

                <!-- HEADER -->

                <VBox spacing="8">

                    <Button text="‹  Retour"
                            prefHeight="65"
                            maxWidth="Infinity"
                            styleClass="btn-back"
                            onAction="#onBack"/>

                    <Label text="RETOURS"
                           styleClass="menu-title"/>

                    <Label text="Gestion des retours"
                           styleClass="subtitle"/>

                </VBox>


                <!-- INFO -->

                <VBox spacing="15">

                    <Label text="RETOUR ARTICLE"
                           styleClass="section-title"/>

                    <Label text="Recherchez un ticket par son numéro, puis indiquez la quantité à retourner pour chaque article."
                           wrapText="true"
                           styleClass="subtitle"/>

                </VBox>


                <Region VBox.vgrow="ALWAYS"/>


                <!-- CURRENT TICKET -->

                <VBox spacing="8"
                      styleClass="side-status">

                    <Label text="TICKET SÉLECTIONNÉ"
                           styleClass="section-title"/>

                    <Label fx:id="originalTicketLabel"
                           styleClass="journey-status"
                           wrapText="true"/>

                </VBox>

            </VBox>


            <!-- ========================= -->
            <!-- RIGHT WORKSPACE -->
            <!-- ========================= -->

            <StackPane HBox.hgrow="ALWAYS"
                       styleClass="workspace">

                <VBox spacing="18">

                    <padding>
                        <Insets top="35"
                                right="40"
                                bottom="35"
                                left="40"/>
                    </padding>


                    <!-- PAGE TITLE -->

                    <VBox spacing="5">

                        <Label text="Retour d'un ticket"
                               styleClass="workspace-title"/>

                        <Label text="Recherchez le ticket puis sélectionnez les articles à retourner."
                               styleClass="workspace-subtitle"/>

                    </VBox>


                    <!-- ========================= -->
                    <!-- TICKET SEARCH -->
                    <!-- ========================= -->

                    <HBox spacing="15"
                          alignment="CENTER_LEFT">

                        <TextField fx:id="ticketIdField"
                                   promptText="Numéro de ticket"
                                   prefHeight="60"
                                   HBox.hgrow="ALWAYS"
                                   onAction="#onLookup"/>

                        <Button text="Rechercher"
                                prefWidth="200"
                                prefHeight="60"
                                styleClass="btn-primary"
                                onAction="#onLookup"/>

                    </HBox>


                    <!-- ========================= -->
                    <!-- ITEMS TABLE -->
                    <!-- ========================= -->

                    <TableView fx:id="itemsTable"
                               VBox.vgrow="ALWAYS"
                               prefHeight="380">

                        <columns>

                            <TableColumn fx:id="colCode"
                                         text="Code"
                                         prefWidth="100"/>

                            <TableColumn fx:id="colLabel"
                                         text="Article"
                                         prefWidth="260"/>

                            <TableColumn fx:id="colSold"
                                         text="Qté vendue"
                                         prefWidth="120"/>

                            <TableColumn fx:id="colReturnQty"
                                         text="Qté à retourner"
                                         prefWidth="150"/>

                            <TableColumn fx:id="colUnitPrice"
                                         text="Prix unitaire"
                                         prefWidth="130"/>

                            <TableColumn fx:id="colRefund"
                                         text="Remboursement"
                                         prefWidth="150"/>

                        </columns>

                    </TableView>


                    <!-- EDIT HINT -->

                    <Label text="💡 Double-cliquez sur « Qté à retourner » pour modifier."
                           styleClass="subtitle"/>


                    <!-- ========================= -->
                    <!-- TOTAL -->
                    <!-- ========================= -->

                    <HBox alignment="CENTER_RIGHT"
                          spacing="15">

                        <Label text="TOTAL À REMBOURSER"
                               styleClass="section-title"/>

                        <Label fx:id="totalLabel"
                               text="0.000 DT"
                               styleClass="section-title"/>

                    </HBox>


                    <!-- ========================= -->
                    <!-- CONFIRM -->
                    <!-- ========================= -->

                    <HBox alignment="CENTER_RIGHT"
                          spacing="15">

                        <Button text="Confirmer le retour"
                                prefWidth="260"
                                prefHeight="70"
                                styleClass="btn-danger"
                                onAction="#onConfirmReturn"/>

                    </HBox>


                    <!-- LOADING -->

                    <HBox alignment="CENTER_RIGHT">

                        <ProgressIndicator fx:id="progressIndicator"
                                           visible="false"
                                           maxHeight="30"
                                           maxWidth="30"/>

                    </HBox>

                </VBox>

            </StackPane>

        </HBox>

    </center>

</BorderPane>