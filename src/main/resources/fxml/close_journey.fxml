<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.caisse.controller.CloseJourneyController"
            prefWidth="1200"
            prefHeight="700"
            styleClass="root-pane">

    <center>

        <HBox styleClass="main-layout">

            <!-- ================================================= -->
            <!-- LEFT SIDEBAR -->
            <!-- ================================================= -->

            <VBox prefWidth="320"
                  minWidth="300"
                  maxWidth="360"
                  spacing="20"
                  styleClass="side-menu">

                <padding>
                    <Insets top="35"
                            right="30"
                            bottom="30"
                            left="30"/>
                </padding>


                <!-- HEADER -->

                <VBox spacing="8">

                    <Button text="‹  Annuler"
                            prefHeight="65"
                            maxWidth="Infinity"
                            styleClass="btn-back"
                            onAction="#onCancel"/>

                    <Label text="FERMETURE"
                           styleClass="menu-title"/>

                    <Label fx:id="journeyLabel"
                           styleClass="subtitle"/>

                    <Label fx:id="cashierLabel"
                           styleClass="subtitle"/>

                </VBox>


                <!-- INFO -->

                <VBox spacing="15">

                    <Label text="COMPTAGE OBLIGATOIRE"
                           styleClass="section-title"/>

                    <Label text="Comptez physiquement les espèces et le total de la carte, puis saisissez ces montants à droite. La fermeture n'est possible que si les montants saisis correspondent exactement aux montants calculés par le système."
                           wrapText="true"
                           styleClass="subtitle"/>

                </VBox>


                <Region VBox.vgrow="ALWAYS"/>


                <!-- LOADING -->

                <HBox alignment="CENTER">

                    <ProgressIndicator fx:id="progressIndicator"
                                       visible="false"
                                       maxHeight="28"
                                       maxWidth="28"/>

                </HBox>


                <!-- CLOSE ACTION -->

                <Button text="Fermer la journée"
                        maxWidth="Infinity"
                        prefHeight="65"
                        styleClass="btn-danger"
                        onAction="#onConfirmClose"/>

            </VBox>


            <!-- ================================================= -->
            <!-- RIGHT WORKSPACE -->
            <!-- ================================================= -->

            <StackPane HBox.hgrow="ALWAYS"
                       styleClass="workspace">

                <VBox spacing="20"
                      maxWidth="700">

                    <padding>
                        <Insets top="35"
                                right="40"
                                bottom="35"
                                left="40"/>
                    </padding>


                    <!-- PAGE TITLE -->

                    <VBox spacing="5">

                        <Label text="Résumé de la journée"
                               styleClass="workspace-title"/>

                        <Label text="Vérifiez les montants calculés puis confirmez le comptage."
                               styleClass="workspace-subtitle"/>

                    </VBox>


                    <!-- ================================================= -->
                    <!-- COMPUTED SUMMARY -->
                    <!-- ================================================= -->

                    <VBox spacing="14"
                          styleClass="summary-card">

                        <Label text="MONTANTS CALCULÉS PAR LE SYSTÈME"
                               styleClass="section-title"/>

                        <GridPane hgap="24" vgap="10">

                            <Label text="Tickets:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="info-label"/>
                            <Label fx:id="ticketsLabel" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="info-value"/>

                            <Label text="Ventes brutes:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="info-label"/>
                            <Label fx:id="grossLabel" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="info-value"/>

                            <Label text="Espèces attendues:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="info-label"/>
                            <Label fx:id="cashLabel" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="info-value"/>

                            <Label text="Carte attendue:" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="info-label"/>
                            <Label fx:id="cardLabel" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="info-value"/>

                            <Label text="Retours:" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="info-label"/>
                            <Label fx:id="returnsLabel" GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="info-value"/>

                        </GridPane>

                        <Separator/>

                        <HBox alignment="CENTER_RIGHT" spacing="10">
                            <Label text="Ventes nettes:" styleClass="section-title"/>
                            <Label fx:id="netLabel" styleClass="section-title"/>
                        </HBox>

                    </VBox>


                    <!-- ================================================= -->
                    <!-- COUNT CONFIRMATION -->
                    <!-- ================================================= -->

                    <VBox spacing="14"
                          styleClass="summary-card">

                        <Label text="CONFIRMATION DU COMPTAGE"
                               styleClass="section-title"/>

                        <Label text="Saisissez les montants réellement comptés. Ils doivent être identiques aux montants attendus ci-dessus."
                               wrapText="true"
                               styleClass="subtitle"/>

                        <HBox spacing="20">

                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Espèces comptées (DT)" styleClass="field-label"/>
                                <TextField fx:id="cashCountField"
                                           promptText="0.000"
                                           prefHeight="52"/>
                            </VBox>

                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Carte comptée (DT)" styleClass="field-label"/>
                                <TextField fx:id="cardCountField"
                                           promptText="0.000"
                                           prefHeight="52"/>
                            </VBox>

                        </HBox>

                        <Label fx:id="mismatchLabel"
                               styleClass="error-text"
                               wrapText="true"
                               visible="false"
                               managed="false"/>

                    </VBox>

                </VBox>

            </StackPane>

        </HBox>

    </center>

</BorderPane>