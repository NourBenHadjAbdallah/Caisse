<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.caisse.controller.ReportController"
            prefWidth="1200"
            prefHeight="700"
            styleClass="root-pane">

    <center>

        <HBox styleClass="main-layout">

            <!-- ================================================= -->
            <!-- LEFT SIDEBAR -->
            <!-- ================================================= -->

            <VBox prefWidth="320"
                  minWidth="300"
                  maxWidth="360"
                  spacing="20"
                  styleClass="side-menu">

                <padding>
                    <Insets top="35"
                            right="30"
                            bottom="30"
                            left="30"/>
                </padding>


                <!-- HEADER -->

                <VBox spacing="8">

                    <Button text="‹  Retour"
                            prefHeight="65"
                            maxWidth="Infinity"
                            styleClass="btn-back"
                            onAction="#onBack"/>

                    <Label text="RAPPORTS"
                           styleClass="menu-title"/>

                    <Label text="Ventes, paiements et retours"
                           styleClass="subtitle"/>

                </VBox>


                <!-- INFO -->

                <VBox spacing="15">

                    <Label text="FILTRES"
                           styleClass="section-title"/>

                    <Label text="Choisissez une période, un caissier ou un mode de paiement, puis générez le rapport."
                           wrapText="true"
                           styleClass="subtitle"/>

                </VBox>


                <Region VBox.vgrow="ALWAYS"/>

            </VBox>


            <!-- ================================================= -->
            <!-- RIGHT WORKSPACE -->
            <!-- ================================================= -->

            <StackPane HBox.hgrow="ALWAYS"
                       styleClass="workspace">

                <VBox spacing="20">

                    <padding>
                        <Insets top="35"
                                right="40"
                                bottom="35"
                                left="40"/>
                    </padding>


                    <!-- PAGE TITLE -->

                    <VBox spacing="5">

                        <Label text="Rapport des ventes"
                               styleClass="workspace-title"/>

                        <Label text="Lecture seule — couvre les journées ouvertes et fermées."
                               styleClass="workspace-subtitle"/>

                    </VBox>


                    <!-- ================================================= -->
                    <!-- FILTERS -->
                    <!-- ================================================= -->

                    <HBox spacing="15"
                          alignment="CENTER_LEFT">

                        <ComboBox fx:id="quickRangeCombo"
                                  promptText="Période"
                                  prefHeight="55"/>

                        <DatePicker fx:id="fromPicker"
                                    promptText="Du"
                                    prefHeight="55"/>

                        <DatePicker fx:id="toPicker"
                                    promptText="Au"
                                    prefHeight="55"/>

                    </HBox>

                    <HBox spacing="15"
                          alignment="CENTER_LEFT">

                        <TextField fx:id="cashierField"
                                   promptText="Filtrer par caissier (code)"
                                   prefHeight="55"
                                   HBox.hgrow="ALWAYS"/>

                        <ComboBox fx:id="paymentCombo"
                                  promptText="Mode de paiement"
                                  prefHeight="55"/>

                        <Button text="Générer"
                                prefWidth="180"
                                prefHeight="55"
                                styleClass="btn-primary"
                                onAction="#onGenerate"/>

                    </HBox>


                    <Separator/>


                    <!-- ================================================= -->
                    <!-- RESULTS -->
                    <!-- ================================================= -->

                    <GridPane hgap="20" vgap="14">

                        <Label text="Ventes totales:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="section-title"/>
                        <Label fx:id="totalSalesLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Nombre de tickets:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="section-title"/>
                        <Label fx:id="ticketCountLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Ventes espèces:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="section-title"/>
                        <Label fx:id="cashSalesLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="Ventes carte:" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="section-title"/>
                        <Label fx:id="cardSalesLabel" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                        <Label text="Retours:" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="section-title"/>
                        <Label fx:id="returnsLabel" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                        <Label text="Ventes nettes:" GridPane.rowIndex="5" GridPane.columnIndex="0" styleClass="section-title"/>
                        <Label fx:id="netSalesLabel" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                        <Label text="Produits vendus:" GridPane.rowIndex="6" GridPane.columnIndex="0" styleClass="section-title"/>
                        <Label fx:id="productsSoldLabel" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                        <Label text="Produits retournés:" GridPane.rowIndex="7" GridPane.columnIndex="0" styleClass="section-title"/>
                        <Label fx:id="productsReturnedLabel" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

                    </GridPane>


                    <!-- LOADING -->

                    <HBox alignment="CENTER_RIGHT">

                        <ProgressIndicator fx:id="progressIndicator"
                                           visible="false"
                                           maxHeight="30"
                                           maxWidth="30"/>

                    </HBox>

                </VBox>

            </StackPane>

        </HBox>

    </center>

</BorderPane>