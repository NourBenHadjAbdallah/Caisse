<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.caisse.controller.TicketController"
            prefWidth="1200"
            prefHeight="700"
            styleClass="root-pane">

    <center>

        <HBox styleClass="main-layout">

            <!-- ================================================= -->
            <!-- LEFT SIDEBAR -->
            <!-- ================================================= -->

            <VBox prefWidth="320"
                  minWidth="300"
                  maxWidth="360"
                  spacing="20"
                  styleClass="side-menu">

                <padding>
                    <Insets top="35"
                            right="30"
                            bottom="30"
                            left="30"/>
                </padding>

                <VBox spacing="8">

                    <Button text="‹  Retour"
                            prefHeight="65"
                            maxWidth="Infinity"
                            styleClass="btn-link"
                            onAction="#onBack"/>

                    <Label text="TICKETS"
                           styleClass="menu-title"/>

                    <Label fx:id="journeyLabel"
                           styleClass="subtitle"/>

                </VBox>

                <VBox spacing="15">

                    <Label text="NOUVEAU TICKET"
                           styleClass="section-title"/>

                    <Label text="Ajoutez les articles au ticket, choisissez le mode de paiement, puis validez."
                           wrapText="true"
                           styleClass="subtitle"/>

                </VBox>

                <Region VBox.vgrow="ALWAYS"/>

                <VBox spacing="8">

                    <Label text="PAIEMENT"
                           styleClass="section-title"/>

                    <Label text="Sélection obligatoire avant validation"
                           wrapText="true"
                           styleClass="subtitle"/>

                </VBox>

            </VBox>


            <!-- ================================================= -->
            <!-- RIGHT WORKSPACE -->
            <!-- ================================================= -->

            <StackPane HBox.hgrow="ALWAYS"
                       styleClass="workspace">

                <VBox spacing="20">

                    <padding>
                        <Insets top="35"
                                right="40"
                                bottom="35"
                                left="40"/>
                    </padding>


                    <!-- TITLE -->

                    <VBox spacing="5">

                        <Label text="Nouveau ticket"
                               styleClass="workspace-title"/>

                        <Label text="Saisissez manuellement le code du produit ou recherchez un article."
                               styleClass="workspace-subtitle"/>

                    </VBox>


                    <!-- ================================================= -->
                    <!-- PRODUCT ENTRY -->
                    <!-- ================================================= -->

                    <HBox spacing="15"
                          alignment="CENTER_LEFT">

                        <TextField fx:id="codeField"
                                   promptText="Saisir le code produit"
                                   prefHeight="65"
                                   HBox.hgrow="ALWAYS"
                                   onAction="#onAddByCode"/>

                        <Button text="Ajouter"
                                prefWidth="180"
                                prefHeight="65"
                                styleClass="btn-primary"
                                onAction="#onAddByCode"/>

                        <Button text="Rechercher"
                                prefWidth="180"
                                prefHeight="65"
                                onAction="#onSearch"/>

                    </HBox>


                    <!-- ================================================= -->
                    <!-- SEARCH RESULTS -->
                    <!-- ================================================= -->

                    <ListView fx:id="searchResults"
                              prefHeight="140"
                              visible="false"
                              managed="false"/>


                    <!-- ================================================= -->
                    <!-- CART -->
                    <!-- ================================================= -->

                    <TableView fx:id="cartTable"
                               VBox.vgrow="ALWAYS"
                               prefHeight="350">

                        <columns>

                            <TableColumn fx:id="colCode"
                                         text="Code"
                                         prefWidth="100"/>

                            <TableColumn fx:id="colLabel"
                                         text="Article"
                                         prefWidth="280"/>

                            <TableColumn fx:id="colQty"
                                         text="Qté"
                                         prefWidth="90"/>

                            <TableColumn fx:id="colPrice"
                                         text="Prix unitaire"
                                         prefWidth="130"/>

                            <TableColumn fx:id="colDiscount"
                                         text="Remise %"
                                         prefWidth="110"/>

                            <TableColumn fx:id="colTotal"
                                         text="Total"
                                         prefWidth="130"/>

                            <TableColumn fx:id="colRemove"
                                         text=""
                                         prefWidth="90"/>

                        </columns>

                    </TableView>


                    <!-- ================================================= -->
                    <!-- TOTAL -->
                    <!-- ================================================= -->

                    <HBox alignment="CENTER_RIGHT"
                          spacing="15">

                        <Label text="TOTAL TICKET"
                               styleClass="section-title"/>

                        <Label fx:id="totalLabel"
                               styleClass="section-title"/>

                    </HBox>


                    <!-- ================================================= -->
                    <!-- PAYMENT -->
                    <!-- ================================================= -->

                    <HBox spacing="15"
                          alignment="CENTER_RIGHT">

                        <Label text="Paiement :"
                               styleClass="section-title"/>


                        <!--
                            ToggleGroup is created and managed
                            by TicketController.java.
                            
                            No payment method is selected by default.
                        -->

                        <ToggleButton fx:id="cashToggle"
                                      text="Espèces"
                                      selected="false"
                                      prefWidth="160"
                                      prefHeight="70"/>


                        <ToggleButton fx:id="cardToggle"
                                      text="Carte bancaire"
                                      selected="false"
                                      prefWidth="190"
                                      prefHeight="70"/>


                        <!--
                            Hidden until a payment method
                            is selected.
                        -->

                        <Button fx:id="validateButton"
                                text="VALIDER LE TICKET"
                                prefWidth="250"
                                prefHeight="75"
                                styleClass="btn-primary"
                                visible="false"
                                managed="false"
                                onAction="#onValidate"/>

                    </HBox>


                    <!-- ================================================= -->
                    <!-- LOADING -->
                    <!-- ================================================= -->

                    <HBox alignment="CENTER_RIGHT">

                        <ProgressIndicator fx:id="progressIndicator"
                                           visible="false"
                                           maxHeight="30"
                                           maxWidth="30"/>

                    </HBox>

                </VBox>

            </StackPane>

        </HBox>

    </center>

</BorderPane>