<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.caisse.controller.TicketController"
            prefWidth="1200"
            prefHeight="700"
            styleClass="root-pane">

    <center>

        <HBox styleClass="main-layout">

            <!-- ================================================= -->
            <!-- LEFT SIDEBAR -->
            <!-- ================================================= -->

            <VBox prefWidth="320"
                  minWidth="300"
                  maxWidth="360"
                  spacing="20"
                  styleClass="side-menu">

                <padding>
                    <Insets top="35"
                            right="30"
                            bottom="30"
                            left="30"/>
                </padding>


                <!-- HEADER -->

                <VBox spacing="8">

              <Button text="‹  Retour"
                     prefHeight="65"
                     maxWidth="Infinity"
                     styleClass="btn-back"
                     onAction="#onBack"/>

                    <Label text="TICKETS"
                           styleClass="menu-title"/>

                    <Label fx:id="journeyLabel"
                           styleClass="subtitle"/>

                </VBox>


                <!-- TICKET INFO -->

                <VBox spacing="15">

                    <Label text="NOUVEAU TICKET"
                           styleClass="section-title"/>

                    <Label text="Ajoutez les articles puis modifiez leur quantité ou leur prix directement dans le tableau."
                           wrapText="true"
                           styleClass="subtitle"/>

                </VBox>


                <Region VBox.vgrow="ALWAYS"/>


                <!-- REPORTS -->

                <Button text="Rapports"
                        maxWidth="Infinity"
                        prefHeight="70"
                        styleClass="btn-secondary"
                        onAction="#onReports"/>


                <!-- CASH DRAWER (placeholder, not wired yet) -->

                <Button text="Ouvrir tiroir"
                        maxWidth="Infinity"
                        prefHeight="60"
                        styleClass="btn-secondary"
                        onAction="#onOpenDrawer"/>


                <!-- TICKET HISTORY -->

                <Button text="Historique des tickets"
                        maxWidth="Infinity"
                        prefHeight="60"
                        styleClass="btn-secondary"
                        onAction="#onHistory"/>

<!-- TICKET X (read-only mid-journey snapshot) -->

              <Button text="Ticket X"
                     maxWidth="Infinity"
                     prefHeight="60"
                     styleClass="btn-secondary"
                     onAction="#onTicketX"/>
                     
                <!-- PAYMENT INFO -->

                <VBox spacing="8">

                    <Label text="PAIEMENT"
                           styleClass="section-title"/>

                    <Label text="Choisissez un mode de paiement pour activer la validation."
                           wrapText="true"
                           styleClass="subtitle"/>

                </VBox>

            </VBox>


            <!-- ================================================= -->
            <!-- RIGHT WORKSPACE -->
            <!-- ================================================= -->

            <StackPane HBox.hgrow="ALWAYS"
                       styleClass="workspace">

                <VBox spacing="20">

                    <padding>
                        <Insets top="35"
                                right="40"
                                bottom="35"
                                left="40"/>
                    </padding>


                    <!-- PAGE TITLE -->

                    <VBox spacing="5">

                        <Label text="Nouveau ticket"
                               styleClass="workspace-title"/>

                        <Label text="Ajoutez les produits manuellement. Un scanner pourra être ajouté plus tard."
                               styleClass="workspace-subtitle"/>

                    </VBox>


                    <!-- ================================================= -->
                    <!-- PRODUCT INPUT -->
                    <!-- ================================================= -->

                    <HBox spacing="15"
                          alignment="CENTER_LEFT">

                        <TextField fx:id="codeField"
                                   promptText="Saisir le code produit"
                                   prefHeight="65"
                                   HBox.hgrow="ALWAYS"
                                   onAction="#onAddByCode"/>

                        <Button text="Ajouter"
                                prefWidth="180"
                                prefHeight="65"
                                styleClass="btn-primary"
                                onAction="#onAddByCode"/>

                        <Button text="Rechercher"
                                prefWidth="180"
                                prefHeight="65"
                                onAction="#onSearch"/>

                    </HBox>


                    <!-- SEARCH RESULTS -->

                    <ListView fx:id="searchResults"
                              prefHeight="140"
                              visible="false"
                              managed="false"/>


                    <!-- ================================================= -->
                    <!-- CART TABLE -->
                    <!-- ================================================= -->

                    <TableView fx:id="cartTable"
                               VBox.vgrow="ALWAYS"
                               prefHeight="350"
                               editable="true">

                        <columns>

                            <TableColumn fx:id="colCode"
                                         text="Code"
                                         prefWidth="100"/>

                            <TableColumn fx:id="colLabel"
                                         text="Article"
                                         prefWidth="280"/>

                            <TableColumn fx:id="colQty"
                                         text="Qté"
                                         prefWidth="100"/>

                            <TableColumn fx:id="colPrice"
                                         text="Prix unitaire"
                                         prefWidth="140"/>

                            <TableColumn fx:id="colDiscount"
                                         text="Remise %"
                                         prefWidth="110"/>

                            <TableColumn fx:id="colTotal"
                                         text="Total"
                                         prefWidth="140"/>

                            <TableColumn fx:id="colRemove"
                                         text="Action"
                                         prefWidth="120"/>

                        </columns>

                    </TableView>


                    <!-- EDIT HINT -->

                    <Label text="💡 Double-cliquez sur Qté ou Prix unitaire pour modifier."
                           styleClass="subtitle"/>


                    <!-- ================================================= -->
                    <!-- TOTAL -->
                    <!-- ================================================= -->

                    <HBox alignment="CENTER_RIGHT"
                          spacing="15">

                        <Label text="TOTAL TICKET"
                               styleClass="section-title"/>

                        <Label fx:id="totalLabel"
                               styleClass="section-title"/>

                    </HBox>


                    <!-- ================================================= -->
                    <!-- PAYMENT -->
                    <!-- ================================================= -->

                    <HBox spacing="15"
                          alignment="CENTER_RIGHT">

                        <Label text="Paiement :"
                               styleClass="section-title"/>


                        <ToggleButton fx:id="cashToggle"
                                      text="Espèces"
                                      selected="false"
                                      prefWidth="160"
                                      prefHeight="70"/>


                        <ToggleButton fx:id="cardToggle"
                                      text="Carte bancaire"
                                      selected="false"
                                      prefWidth="190"
                                      prefHeight="70"/>


                        <!-- ALWAYS VISIBLE -->

                        <Button fx:id="validateButton"
                                text="VALIDER LE TICKET"
                                prefWidth="250"
                                prefHeight="75"
                                styleClass="btn-primary"
                                disable="true"
                                onAction="#onValidate"/>

                    </HBox>


                    <!-- LOADING -->

                    <HBox alignment="CENTER_RIGHT">

                        <ProgressIndicator fx:id="progressIndicator"
                                           visible="false"
                                           maxHeight="30"
                                           maxWidth="30"/>

                    </HBox>

                </VBox>

            </StackPane>

        </HBox>

    </center>

</BorderPane>